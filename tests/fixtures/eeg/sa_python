#!/usr/bin/env python3
"""A stand-in for the source-analytics interpreter, for the golden builds.

The gallery asks source-analytics' interpreter three things: its analysis
metadata (the nav grouping), whether its viz modules import, and — through the
two worker scripts — to draw brain mosaics and circos. This answers all three
without source-analytics: the metadata from ``analysis_meta.json`` beside it
(source-analytics v0.8.2's ``analysis_meta()``), the probes with success, and
each worker call with one placeholder PNG named after what was asked for.

When ``FAKE_SA_LOG`` is set, each worker call's payload is appended to that file
as one JSON line, so a golden build also pins what the gallery hands the workers.
"""

import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

# A valid 1x1 PNG.
PNG = bytes.fromhex(
    "89504e470d0a1a0a0000000d4948445200000001000000010802000000907753de"
    "0000000c4944415478da63f8ffff3f0005fe02fea7d6a4580000000049454e44ae426082"
)


def main() -> int:
    args = sys.argv[1:]
    if args[:1] == ["-c"]:
        code = args[1] if len(args) > 1 else ""
        if "analysis_meta" in code:
            print(json.dumps(json.loads((HERE / "analysis_meta.json").read_text())))
            return 0
        return 0 if code.startswith("import source_analytics") else 1

    worker, payload = Path(args[0]).name, json.loads(args[1])
    log = os.environ.get("FAKE_SA_LOG")
    if log:
        with open(log, "a") as f:
            f.write(json.dumps({"worker": worker, "payload": payload}, sort_keys=True) + "\n")

    out = Path(payload["out_dir"])
    out.mkdir(parents=True, exist_ok=True)
    if worker == "_brain_render_worker.py":
        names = [f"mosaic__{payload['analysis_name']}.png"]
    elif worker == "_circos_render_worker.py":
        names = [f"circos__{m}__fixture.png" for m in payload.get("metrics") or []]
    else:
        print(f"unknown worker {worker}", file=sys.stderr)
        return 1
    for name in names:
        (out / name).write_bytes(PNG)
    print(json.dumps([str(out / n) for n in names]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
